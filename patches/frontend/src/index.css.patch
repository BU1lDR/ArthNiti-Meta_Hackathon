diff --git a/frontend/src/index.css b/frontend/src/index.css
index d73114b..77068b1 100644
--- a/frontend/src/index.css
+++ b/frontend/src/index.css
@@ -1472,0 +1473,69 @@ summary:focus-visible {
+/* The traffic light (ResultBand.jsx). The tone is the left rule and the shape's fill;
+   the glyph colour is the one that reads on that fill in both themes. Yellow is pale
+   on a white page, so the shape also carries an outline in the text colour. */
+.ui-band {
+  display: flex;
+  align-items: center;
+  gap: 14px;
+  border: 1px solid var(--color-border);
+  border-left: 6px solid var(--band-tone);
+  border-radius: 8px;
+  background: var(--color-surface-soft);
+  padding: 14px 16px;
+  overflow-wrap: anywhere;
+}
+
+.ui-band-green {
+  --band-tone: var(--color-success);
+  --band-glyph: var(--color-surface);
+}
+
+.ui-band-yellow {
+  --band-tone: var(--color-accent);
+  --band-glyph: var(--color-on-accent);
+}
+
+.ui-band-red {
+  --band-tone: var(--color-danger);
+  --band-glyph: var(--color-surface);
+}
+
+.ui-band-shape {
+  width: 3rem;
+  height: 3rem;
+  flex: none;
+}
+
+.ui-band-body {
+  fill: var(--band-tone);
+  stroke: var(--color-text);
+  stroke-width: 2.5;
+  stroke-linejoin: round;
+}
+
+.ui-band-mark {
+  fill: none;
+  stroke: var(--band-glyph);
+  stroke-width: 4;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+}
+
+.ui-band-dot {
+  fill: var(--band-glyph);
+}
+
+.ui-band-label {
+  font-size: 1.05rem;
+  font-weight: 800;
+  line-height: 1.4;
+  color: var(--color-text);
+}
+
+.ui-band-basis {
+  margin-top: 2px;
+  font-size: 0.875rem;
+  line-height: 1.5;
+  color: var(--color-text-muted);
+}
+
@@ -1506,0 +1576,4 @@ summary:focus-visible {
+/* The label drops under the bars when it would squeeze them below 1.5rem each.
+   It was `flex: 0 0 auto` in a nowrap row, so a long label (Malayalam, "Step 3 of
+   4 · Your results", largest text) left the four bars 3 to 0px wide and, at 320px,
+   stuck out of the page by 17px. */
@@ -1508,0 +1582 @@ summary:focus-visible {
+  flex-wrap: wrap;
@@ -1516 +1590 @@ summary:focus-visible {
-  flex: 1;
+  flex: 1 0 1.5rem;
@@ -1527 +1601,2 @@ summary:focus-visible {
-  flex: 0 0 auto;
+  flex: 0 1 auto;
+  min-width: 0;
@@ -2216,0 +2292 @@ summary:focus-visible {
+  .ui-band,

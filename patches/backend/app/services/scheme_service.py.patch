+def _check_first(scheme):
+    """
+    The sentences and the codes of the eligibility lines a reader should check
+    before the trip (gen_schemes.CHECK_FIRST). Found by code, never by position,
+    and returned as new lists, so a consumer cannot reach the shared dataset
+    through them. A scheme without the field, or with a code it does not carry,
+    gives nothing for that code.
+    """
+    codes = scheme.get("eligibility_codes", [])
+    wanted = [code for code in scheme.get("check_first_codes", []) if code in codes]
+
+    return [scheme["eligibility_rules"][codes.index(code)] for code in wanted], wanted
+

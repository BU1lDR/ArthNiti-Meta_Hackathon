@@ -462,0 +470,35 @@ def test_an_unknown_language_is_refused():
+# ---------------------------------------------------------------- the question the person was just asked
+
+
+def test_with_no_question_asked_the_instructions_do_not_mention_one():
+    assert "just asked" not in intake.extraction_messages("x", "en")[0]["content"]
+    assert intake.extraction_messages("x", "en", asking=None) == intake.extraction_messages("x", "en")
+
+
+@pytest.mark.parametrize("field", intake.FORM_ORDER)
+def test_the_question_asked_is_named_in_our_message_and_the_words_stay_in_theirs(field):
+    # A bare "fifty thousand" belongs to no field unless the code says which
+    # question the screen was on. The code names the field; the model only reads.
+    messages = intake.extraction_messages(MARKER, "en", asking=field)
+
+    assert field in messages[0]["content"].split("just asked", 1)[1]
+    assert MARKER not in messages[0]["content"]
+    assert messages[1] == {"role": "user", "content": MARKER}
+
+
+def test_a_short_reply_counts_only_when_it_answers_the_question_asked():
+    asked = intake.extraction_messages("x", "en", asking="monthly_emi")[0]["content"].split("just asked", 1)[1]
+
+    assert "answers that question" in asked
+    assert "leave monthly_emi out" in asked
+    # "No" to "do you repay a loan?" is an answer, and it is 0.
+    assert "no or none means 0" in asked
+    # The rule that a spoken zero never stands for a household with no income stays.
+    assert "household_monthly_income" in asked
+
+
+def test_a_field_that_is_not_on_the_form_cannot_be_asked_about():
+    with pytest.raises(KeyError):
+        intake.extraction_messages("x", "en", asking="password")
+
+

+
+def test_the_speech_keywords_are_a_short_list_of_plain_words():
+    # Meta states no limit on the list, so it stays short.
+    words = intake.SPEECH_KEYWORDS
+
+    assert isinstance(words, tuple)
+    assert 0 < len(words) <= 20

+# ------------------------------------------------------------------ the band
+#
+# Green, yellow and red are the status and the priority read as a traffic
+# light, not a second opinion. Green is exactly the "good" status. Red is
+# exactly the "high" priority: not making a profit, high repayment pressure,
+# or a household over its limit. Yellow is everything in between.
+
+
+def band_for(
+    financial_status="profitable",
+    risk_level="low",
+    feasibility="feasible",
+    funding_gap=0,
+    household_check="within_limit",
+):
+    return build_mvp_summary(
+        financial_analysis={
+            "financial_status": financial_status,
+            "funding_gap": funding_gap,
+        },
+        risk_analysis={"risk_level": risk_level, "household_check": household_check},
+        business_analysis={"feasibility_status": feasibility},
+        advisory={"recommendations": ["Maintain the current business model."]},
+    )["band"]
+
+
+@pytest.mark.parametrize(
+    "band, changes",
+    [
+        ("green", {}),
+        ("green", {"household_check": "not_checked"}),
+        ("red", {"financial_status": "loss"}),
+        ("red", {"financial_status": "break_even"}),
+        ("red", {"financial_status": "loss", "funding_gap": 50000}),
+        ("red", {"risk_level": "high"}),
+        ("red", {"household_check": "over_limit"}),
+        # Red wins over a yellow cause.
+        ("red", {"risk_level": "moderate", "household_check": "over_limit"}),
+        ("yellow", {"risk_level": "moderate"}),
+        ("yellow", {"funding_gap": 50000}),
+        ("yellow", {"feasibility": "not_feasible"}),
+        ("yellow", {"feasibility": "break_even"}),
+    ],
+)
+def test_the_band_follows_the_situation(band, changes):
+    assert band_for(**changes) == band
